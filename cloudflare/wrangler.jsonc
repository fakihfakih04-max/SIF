{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sif-mobile-computer",
  "main": "src/worker.py",
  "compatibility_date": "2026-09-19",
  "compatibility_flags": ["python_workers"],
  "assets": {
    "directory": "frontend",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sif-mobile-computer-db",
      "database_id": "33453539-4c5f-4f4d-84e0-e6fa8a7df529"
    }
  ]
}
